# chipsmith's settings (config/settings.ts). Copy to .env and change what you need; a variable set
# in the shell wins over this file. Left empty or out, a setting has its default.

# The folder holding clips/, songs/ and jobs/. Default: the project folder.
CHIPSMITH_DATA=

# The port the app is served on. Default: 6502.
CHIPSMITH_PORT=

# The old project's checkout (branch archive). Default: ../chiptune-archive.
CHIPSMITH_ARCHIVE=

# The programs the app calls. Defaults: the Furnace app in /Applications, ffmpeg and node on the
# PATH (node: the one running the server), claude in ~/.local/bin or on the PATH.
CHIPSMITH_FURNACE=
CHIPSMITH_FFMPEG=
CHIPSMITH_CLAUDE=
CHIPSMITH_NODE=
